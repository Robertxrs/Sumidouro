datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TaskList {
  id        String        @id @default(cuid())
  name      String
  color     String
  tasks     Task[]
  sections  TaskSection[]
  createdAt DateTime      @default(now())
}

model TaskSection {
  id        String    @id @default(cuid())
  name      String
  order     Int       @default(0)
  listId    String?
  list      TaskList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime  @default(now())
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean      @default(false)
  isHabit     Boolean      @default(false)
  priority    String       @default("P4") // "P1" | "P2" | "P3" | "P4"
  order       Int          @default(0)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parentId    String?
  parent      Task?        @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]       @relation("SubTasks")
  listId      String?
  list        TaskList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  sectionId   String?
  section     TaskSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
}


model NoteGroup {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("bg-red-500")
  notes     Note[]
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model Note {
  id               String     @id @default(cuid())
  title            String
  content          String?
  imageUrl         String?
  imageDescription String?
  groupId          String?
  group            NoteGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model ChatMessage {
  id        String    @id @default(cuid())
  role      String    // "user" | "assistant"
  content   String
  groupId   String
  group     NoteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  color        String        // Ex: "bg-blue-500"
  type         String        // "INCOME" ou "EXPENSE"
  transactions Transaction[]
}

model Transaction {
  id            String    @id @default(cuid())
  title         String
  amount        Float
  type          String    // "INCOME" ou "EXPENSE"
  date          DateTime  @default(now())
  isRecurring   Boolean   @default(false)
  isCompleted   Boolean   @default(false)
  lastPaidMonth String?   // Ex: "2026-10" para recorrentes
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  createdAt     DateTime  @default(now())
}


